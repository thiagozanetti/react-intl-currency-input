{
  "name": "react-intl-currency-input",
  "version": "1.0.0",
  "description": "A React component for i18n currency input using the Intl API.",
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "start:app": "vite app --port 3000 --host 0.0.0.0 --open",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint app lib test --ext .ts,.tsx",
    "preview:app": "vite preview app --outDir $PWD/dist/app --port 3000 --host 0.0.0.0 --open",
    "build:all": "npm run build:lib && npm run build:app",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:legacy:browser": "playwright test --config=playwright.legacy.config.ts --project=chromium --project=firefox --project=webkit",
    "build:app": "rm -rf dist/app && vite build app --outDir $PWD/dist/app --minify",
    "build:lib": "rm -rf dist/lib && tsup lib/index.tsx --out-dir dist/lib --format cjs,esm --dts --external react --external react-dom",
    "pack:check": "npm pack --dry-run",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "big.js": "6.2.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.7",
    "@types/big.js": "6.2.2",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-syntax-highlighter": "15.5.13",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "21.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-syntax-highlighter": "16.1.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagozanetti/react-intl-currency-input.git"
  },
  "keywords": [
    "react",
    "currency-input",
    "money-input",
    "currency",
    "number-input",
    "intl",
    "i18n",
    "internationalization",
    "currency-formatting",
    "number-formatting",
    "typescript",
    "accessible",
    "form-input",
    "ssr",
    "react18",
    "react19"
  ],
  "author": "Thiago Zanetti <thiago.project@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thiagozanetti/react-intl-currency-input/issues"
  },
  "homepage": "https://github.com/thiagozanetti/react-intl-currency-input#readme",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "workspaces": [
    "app/*",
    "lib/*"
  ]
}
