{
  "name": "react-intl-currency-input",
  "version": "1.0.0",
  "description": "A React component for i18n currency input using the Intl API.",
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "start:app": "vite app --port 3000 --host 0.0.0.0 --open",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint": "biome check app lib test",
    "preview:app": "vite preview app --outDir $PWD/dist/app --port 3000 --host 0.0.0.0 --open",
    "build:all": "npm run build:lib && npm run build:app",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:legacy:browser": "playwright test --config=playwright.legacy.config.ts --project=chromium --project=firefox --project=webkit",
    "build:app": "node scripts/clean.mjs dist/app && vite build app --config $PWD/vite.config.ts --outDir $PWD/dist/app --minify",
    "build:lib": "tsdown",
    "pack:check": "npm pack --dry-run",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagozanetti/react-intl-currency-input.git"
  },
  "keywords": [
    "react",
    "currency-input",
    "money-input",
    "currency",
    "number-input",
    "intl",
    "i18n",
    "internationalization",
    "currency-formatting",
    "number-formatting",
    "typescript",
    "accessible",
    "form-input",
    "ssr",
    "react18",
    "react19"
  ],
  "author": "Thiago Zanetti <thiago.project@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thiagozanetti/react-intl-currency-input/issues"
  },
  "homepage": "https://github.com/thiagozanetti/react-intl-currency-input#readme",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "workspaces": [
    "app/*",
    "lib/*"
  ]
}
